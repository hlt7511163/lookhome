<view class="page">
  <!-- 统计条 -->
  <view class="stat-bar">
    <view class="stat-item">
      <view class="stat-value amount-red">{{statText.unpaid}}</view>
      <view class="stat-label">待缴（元）</view>
    </view>
    <view class="stat-item">
      <view class="stat-value amount-red">{{statText.overdue}}</view>
      <view class="stat-label">逾期（元）</view>
    </view>
    <view class="stat-item">
      <view class="stat-value amount-green">{{statText.paid}}</view>
      <view class="stat-label">已缴（元）</view>
    </view>
  </view>

  <!-- 搜索 -->
  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      type="text"
      value="{{keyword}}"
      placeholder="{{searchPlaceholder}}"
      confirm-type="search"
      bindinput="onSearchInput"
    />
    <view class="search-clear" wx:if="{{keyword}}" catchtap="clearSearch">✕</view>
  </view>

  <!-- 推送账单工具栏 -->
  <view class="push-bar">
    <view class="push-left">
      <view class="push-title">推送账单给租客</view>
      <view class="push-sub">未提醒 {{pushCount}} 条 · 租客端「消息」可见</view>
    </view>
    <view class="push-btn {{pushCount === 0 ? 'push-btn-off' : ''}}" bindtap="pushBatch">{{pushing ? '推送中...' : '📢 一键推送'}}</view>
  </view>

  <!-- 筛选 -->
  <scroll-view scroll-x class="filter-scroll">
    <view class="filter-bar">
      <view
        wx:for="{{filters}}"
        wx:key="key"
        class="filter-item {{filter === item.key ? 'filter-active' : ''}}"
        data-key="{{item.key}}"
        bindtap="switchFilter"
      >{{item.text}}</view>
    </view>
  </scroll-view>

  <!-- 列表 -->
  <view class="search-tip" wx:if="{{keyword}}">匹配 {{visible.length}} 条 / 共 {{bills.length}} 条</view>

  <view class="empty" wx:if="{{visible.length === 0 && keyword}}">没有匹配「{{keyword}}」的账单</view>
  <view class="empty" wx:elif="{{bills.length === 0}}">暂无账单</view>

  <view class="bill-card" wx:for="{{visible}}" wx:key="id" data-id="{{item.id}}" bindtap="goDetail">
    <view class="bill-head">
      <text class="bill-period">{{item.period}}</text>
      <text class="tag {{item.statusClass}}">{{item.statusText}}</text>
    </view>
    <view class="bill-title">{{item.title}}</view>
    <view class="bill-meta">{{item.tenant_name}} · {{item.property_name}} {{item.room_no}}</view>
    <view class="bill-foot">
      <view class="bill-left">
        <text class="bill-amount">¥{{item.total}}</text>
        <text wx:if="{{item.paid_amount > 0}}" class="bill-paid"> 已付 ¥{{item.paid_amount}}</text>
      </view>
      <view class="bill-right">
        <text class="bill-remain" wx:if="{{item.canPush}}">待收 ¥{{item.remain}}</text>
        <text class="remind-flag" wx:if="{{item.reminded}}">{{item.remindText}}</text>
        <view class="push-chip" wx:if="{{item.canPush && !item.reminded}}" data-id="{{item.id}}" catchtap="pushOne">推送</view>
      </view>
    </view>
  </view>

  <custom-tab-bar />
  <view style="height: 140rpx;"></view>
</view>
