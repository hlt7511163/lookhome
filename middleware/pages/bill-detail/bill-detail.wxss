.detail-head {
  background: linear-gradient(135deg, #07C160 0%, #04a94d 100%);
  margin: 24rpx;
  border-radius: 20rpx;
  padding: 48rpx 32rpx;
  color: #ffffff;
  text-align: center;
  box-shadow: 0 6rpx 20rpx rgba(7, 193, 96, 0.25);
}
.dh-amount { font-size: 72rpx; font-weight: 700; }
.dh-label { font-size: 24rpx; opacity: 0.85; margin-top: 8rpx; }
.dh-tags { margin-top: 20rpx; }
.dh-tags .tag { margin: 0 8rpx; background: rgba(255, 255, 255, 0.25); color: #ffffff; }

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid #f7f7f7;
}
.info-row:last-child { border-bottom: none; }
.info-label { color: #6b7280; }

.fee-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid #f7f7f7;
}
.fee-name { color: #374151; }
.fee-qty { font-size: 22rpx; color: #9ca3af; margin-left: 12rpx; }
.fee-amount { font-weight: 600; }
.fee-total {
  display: flex;
  justify-content: space-between;
  padding-top: 18rpx;
  margin-top: 6rpx;
  border-top: 2rpx solid #f3f4f6;
  font-weight: 600;
}

.pay-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f7f7f7;
  font-size: 26rpx;
}
.pay-row:last-child { border-bottom: none; }
.pay-mode { color: #374151; }
.pay-status { margin-left: 12rpx; }
.pay-right { text-align: right; }
.pay-time { display: block; font-size: 22rpx; color: #9ca3af; margin-top: 4rpx; }

/* 弹窗 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 200;
}
.modal {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
}
.modal-title { font-size: 32rpx; font-weight: 600; text-align: center; margin-bottom: 24rpx; }
.modal-row {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  padding: 12rpx 0;
}
.modal-label { color: #6b7280; }
.modal-input {
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 30rpx;
}
.modal-tip { font-size: 22rpx; color: #9ca3af; margin: 8rpx 0 20rpx; line-height: 1.6; }
.modal-btns { display: flex; gap: 20rpx; margin-top: 12rpx; }
.modal-btn {
  flex: 1;
  font-size: 28rpx;
  background: #f3f4f6;
  color: #374151;
  border-radius: 12rpx;
}
.modal-btn::after { border: none; }
.modal-btn-ok { background: #07C160; color: #ffffff; }
