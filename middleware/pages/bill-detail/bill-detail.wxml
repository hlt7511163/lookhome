<view class="page {{pageClass}}">
  <block wx:if="{{bill}}">
    <!-- 金额头部 -->
    <view class="detail-head">
      <view class="dh-amount">{{bill.total}}</view>
      <view class="dh-label">账单金额（元）</view>
      <view class="dh-tags">
        <text class="tag {{bill.statusClass}}">{{bill.statusText}}</text>
        <text class="tag st-info">{{bill.typeText}}</text>
      </view>
    </view>

    <!-- 基本信息 -->
    <view class="card">
      <view class="info-row"><text class="info-label">账期</text><text>{{bill.period}}</text></view>
      <view class="info-row"><text class="info-label">标题</text><text>{{bill.title}}</text></view>
      <view class="info-row" wx:if="{{bill.property_name}}"><text class="info-label">房间</text><text>{{bill.property_name}} · {{bill.room_no}}</text></view>
      <view class="info-row" wx:if="{{bill.tenant_name}}"><text class="info-label">租客</text><text>{{bill.tenant_name}}</text></view>
      <view class="info-row"><text class="info-label">已付</text><text class="amount-green">¥{{bill.paid_amount || 0}}</text></view>
      <view class="info-row" wx:if="{{bill.status !== 'paid'}}"><text class="info-label">待付</text><text class="amount-red">¥{{bill.remain}}</text></view>
      <view class="info-row" wx:if="{{bill.paid_at}}"><text class="info-label">缴清时间</text><text>{{bill.paid_at}}</text></view>
    </view>

    <!-- 费用明细 -->
    <view class="card" wx:if="{{items.length > 0}}">
      <view class="card-title">费用明细</view>
      <view class="fee-row" wx:for="{{items}}" wx:key="id">
        <view class="fee-name">
          <text>{{item.fee_name}}</text>
          <text wx:if="{{item.quantity}}" class="fee-qty">{{item.quantity}} × {{item.rate}}</text>
        </view>
        <text class="fee-amount">¥{{item.amount}}</text>
      </view>
      <view class="fee-total">
        <text>合计</text>
        <text class="amount-red">¥{{bill.total}}</text>
      </view>
    </view>

    <!-- 收款记录 -->
    <view class="card" wx:if="{{payments.length > 0}}">
      <view class="card-title">收款记录</view>
      <view class="pay-row" wx:for="{{payments}}" wx:key="id">
        <view>
          <text class="pay-mode">{{item.pay_mode === 'wechat' ? '微信支付' : '线下支付'}}</text>
          <text class="tag {{item.confirm_status === 'confirmed' ? 'st-paid' : 'st-unpaid'}} pay-status">{{item.confirmText}}</text>
        </view>
        <view class="pay-right">
          <text class="amount">¥{{item.amount}}</text>
          <text class="pay-time">{{item.created_at}}</text>
        </view>
      </view>
    </view>
  </block>

  <view wx:else class="empty">加载中...</view>

  <!-- 租客：立即支付 -->
  <view class="footer-bar" wx:if="{{role === 'tenant' && bill && bill.status !== 'paid' && bill.status !== 'void'}}">
    <view class="footer-info">待付 <text class="amount-red">¥{{bill.remain}}</text></view>
    <button class="btn-primary" loading="{{paying}}" bindtap="openPay">立即支付</button>
  </view>

  <!-- 管理端：手工确认收款 -->
  <view class="footer-bar" wx:if="{{role === 'admin' && bill && bill.status !== 'paid' && bill.status !== 'void'}}">
    <view class="footer-info">待收 <text class="amount-red">¥{{bill.remain}}</text></view>
    <button class="btn-primary" loading="{{paying}}" bindtap="openManual">手工确认收款</button>
  </view>

  <!-- 支付弹窗（租客）-->
  <view class="mask" wx:if="{{payModal}}" bindtap="closePay">
    <view class="modal" catchtap="noop">
      <view class="modal-title">支付账单</view>
      <view class="modal-row">
        <text class="modal-label">账单金额</text>
        <text class="amount-red">¥{{bill.total}}</text>
      </view>
      <view class="modal-row">
        <text class="modal-label">待付金额</text>
        <text class="amount-red">¥{{bill.remain}}</text>
      </view>
      <view class="form-item">
        <view class="form-label">支付金额</view>
        <input class="modal-input" type="digit" value="{{payAmount}}" bindinput="onPayAmount" />
      </view>
      <view class="modal-tip">点击「确认支付」后将通过微信支付完成付款；若线上支付未开通，将展示线下转账指引。</view>
      <view class="modal-btns">
        <button class="modal-btn" bindtap="closePay">取消</button>
        <button class="modal-btn modal-btn-ok" loading="{{paying}}" bindtap="confirmPay">确认支付</button>
      </view>
    </view>
  </view>

  <!-- 手工收款弹窗（管理端）-->
  <view class="mask" wx:if="{{manualModal}}" bindtap="closeManual">
    <view class="modal" catchtap="noop">
      <view class="modal-title">手工确认收款</view>
      <view class="modal-row">
        <text class="modal-label">账单金额</text>
        <text>¥{{bill.total}}</text>
      </view>
      <view class="modal-row">
        <text class="modal-label">待收金额</text>
        <text class="amount-red">¥{{bill.remain}}</text>
      </view>
      <view class="form-item">
        <view class="form-label">收款金额</view>
        <input class="modal-input" type="digit" value="{{manualAmount}}" bindinput="onManualAmount" />
      </view>
      <view class="form-item">
        <view class="form-label">备注（可选）</view>
        <input class="modal-input" placeholder="如：现金 / 转账" value="{{manualRemark}}" bindinput="onManualRemark" />
      </view>
      <view class="modal-btns">
        <button class="modal-btn" bindtap="closeManual">取消</button>
        <button class="modal-btn modal-btn-ok" loading="{{paying}}" bindtap="confirmManual">确认收款</button>
      </view>
    </view>
  </view>
</view>
