.profile-head {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #1f2937 0%, #374151 100%);
  margin: 24rpx;
  border-radius: 20rpx;
  padding: 44rpx 32rpx;
  color: #ffffff;
}
.avatar {
  width: 100rpx; height: 100rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  display: flex; align-items: center; justify-content: center;
  font-size: 48rpx;
}
.p-meta { flex: 1; margin-left: 24rpx; }
.p-name { font-size: 34rpx; font-weight: 600; }
.p-sub { font-size: 24rpx; opacity: 0.75; margin-top: 6rpx; }

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #07C160;
}
.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 26rpx;
  border-bottom: 1rpx solid #f7f7f7;
}
.info-row:last-child { border-bottom: none; }
.info-label { color: #6b7280; }

.menu-card { padding: 0; overflow: hidden; }
.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 28rpx;
  font-size: 28rpx;
}
.cell-arrow { color: #9ca3af; }

.logout-btn {
  background: #ffffff;
  color: #cf1322;
  font-size: 30rpx;
  border-radius: 12rpx;
  border: 1rpx solid #ffccc7;
}
.logout-btn::after { border: none; }

.version {
  text-align: center;
  font-size: 22rpx;
  color: #d1d5db;
  margin: 32rpx 0;
}

/* 弹窗 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 200;
}
.modal {
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
}
.modal-title { font-size: 32rpx; font-weight: 600; text-align: center; margin-bottom: 24rpx; }
.modal-input {
  border: 1rpx solid #e5e7eb;
  border-radius: 10rpx;
  padding: 18rpx 20rpx;
  font-size: 30rpx;
}
.modal-btns { display: flex; gap: 20rpx; margin-top: 12rpx; }
.modal-btn {
  flex: 1;
  font-size: 28rpx;
  background: #f3f4f6;
  color: #374151;
  border-radius: 12rpx;
}
.modal-btn::after { border: none; }
.modal-btn-ok { background: #07C160; color: #ffffff; }
