<view class="page">
  <!-- 搜索 -->
  <view class="search-bar">
    <text class="search-icon">🔍</text>
    <input
      class="search-input"
      type="text"
      value="{{keyword}}"
      placeholder="{{searchPlaceholder}}"
      confirm-type="search"
      bindinput="onSearchInput"
    />
    <view class="search-clear" wx:if="{{keyword}}" catchtap="clearSearch">✕</view>
  </view>

  <view class="list-head" wx:if="{{reminders.length > 0}}">
    <text class="lh-tip">点击提醒可查看对应账单</text>
    <text class="lh-action" bindtap="readAll">全部已读</text>
  </view>

  <view class="search-tip" wx:if="{{keyword}}">匹配 {{visible.length}} 条 / 共 {{reminders.length}} 条</view>

  <view class="empty" wx:if="{{visible.length === 0 && keyword}}">没有匹配「{{keyword}}」的提醒</view>
  <view class="empty" wx:elif="{{reminders.length === 0}}">暂无缴费提醒</view>

  <view
    class="msg-card {{item.unread ? 'msg-unread' : ''}}"
    wx:for="{{visible}}"
    wx:key="id"
    data-id="{{item.id}}"
    bindtap="openReminder"
  >
    <view class="msg-head">
      <text class="msg-kind">{{item.kindText}}</text>
      <view class="msg-dot" wx:if="{{item.unread}}"></view>
      <text class="msg-time">{{item.created_at}}</text>
    </view>
    <view class="msg-title">{{item.title}}</view>
    <view class="msg-content">{{item.content}}</view>
    <view class="msg-foot" wx:if="{{item.bill_id}}">
      <text class="msg-bill">{{item.period}} · {{item.room_no}} · ¥{{item.total}}</text>
      <text class="msg-go">查看账单 ›</text>
    </view>
  </view>

  <custom-tab-bar />
  <view style="height: 140rpx;"></view>
</view>
