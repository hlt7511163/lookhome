<view class="page">
  <view class="doc-head">
    <view class="doc-title">LookHome {{tab === 'terms' ? '用户协议' : '隐私政策'}}</view>
    <view class="doc-sub">生效日期：2026-11-21</view>
  </view>

  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{tab === item.key ? 'tab-on' : ''}}"
      data-key="{{item.key}}"
      bindtap="switchTab"
    >{{item.text}}</view>
  </view>

  <view class="card" wx:for="{{tab === 'terms' ? terms : privacy}}" wx:key="title" wx:for-item="sec">
    <view class="sec-title">{{sec.title}}</view>
    <view class="sec-item" wx:for="{{sec.items}}" wx:key="*this" wx:for-item="line">
      <text class="dot">·</text>
      <text class="line">{{line}}</text>
    </view>
  </view>

  <view class="foot-tip">如对本政策有疑问，可通过「我的 - 联系房东」与我们联系。</view>
</view>
