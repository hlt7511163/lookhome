<view class="page">
  <!-- 状态筛选 -->
  <view class="filter-bar">
    <scroll-view class="filter-scroll" scroll-x enable-flex>
      <view
        wx:for="{{filters}}"
        wx:key="key"
        class="filter-chip {{filter === item.key ? 'chip-on' : ''}}"
        data-key="{{item.key}}"
        bindtap="switchFilter"
      >
        {{item.text}}<text wx:if="{{item.key === 'pending' && counts.pending > 0}}" class="chip-num">{{counts.pending}}</text>
      </view>
    </scroll-view>
  </view>

  <view class="empty" wx:if="{{loadError}}">{{loadError}}</view>
  <view class="empty" wx:elif="{{visible.length === 0}}">暂无退款申请</view>

  <view class="rf-card" wx:for="{{visible}}" wx:key="id">
    <view class="rf-head">
      <view class="rf-user">
        <view class="avatar">{{item.initial}}</view>
        <view class="rf-meta">
          <view class="rf-name">{{item.tenantName}}</view>
          <view class="rf-sub">{{item.roomText}}<text wx:if="{{item.phoneText}}"> · {{item.phoneText}}</text></view>
        </view>
      </view>
      <text class="tag {{item.statusClass}}">{{item.statusText}}</text>
    </view>

    <view class="rf-amount-row">
      <text class="rf-amount">¥{{item.amountText}}</text>
      <text class="rf-time">{{item.created_at}}</text>
    </view>

    <view class="rf-remark" wx:if="{{item.apply_remark}}">申请说明：{{item.apply_remark}}</view>
    <view class="rf-remark rf-reject" wx:if="{{item.reject_reason}}">驳回原因：{{item.reject_reason}}</view>

    <view class="rf-actions" wx:if="{{item.canAct}}">
      <view class="act-btn act-no" data-id="{{item.id}}" catchtap="openReject">驳回</view>
      <view class="act-btn act-ok" data-id="{{item.id}}" catchtap="openApprove">通过并退款</view>
    </view>

    <!-- 通过表单 -->
    <view class="form-block" wx:if="{{approveId === item.id}}">
      <view class="form-title">确认通过退款</view>
      <view class="form-tip">线上支付的款项由服务端按原路退回；线下支付的请自行完成转账后再确认。</view>
      <input class="form-input" value="{{approveRemark}}" bindinput="onApproveRemark" placeholder="审批备注（可选）" />
      <view class="form-btns">
        <view class="form-btn" catchtap="closeApprove">取消</view>
        <view class="form-btn form-btn-ok" catchtap="submitApprove">确认通过</view>
      </view>
    </view>

    <!-- 驳回表单 -->
    <view class="form-block" wx:if="{{rejectId === item.id}}">
      <view class="form-title">驳回原因（选填）</view>
      <textarea class="form-textarea" value="{{rejectReason}}" bindinput="onRejectReason" placeholder="如：合同尚未到期 / 仍有未缴账单" />
      <view class="form-btns">
        <view class="form-btn" catchtap="closeReject">取消</view>
        <view class="form-btn form-btn-no" catchtap="submitReject">确认驳回</view>
      </view>
    </view>
  </view>

  <admin-tabbar />
  <view style="height: 140rpx;"></view>
</view>
