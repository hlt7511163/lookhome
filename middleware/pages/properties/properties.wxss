page { background: #f5f7fa; }

.site-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 24rpx 24rpx 16rpx;
}
.site-title { font-size: 32rpx; font-weight: 700; }
.site-phone { font-size: 24rpx; color: #07C160; }

.filter-bar {
  display: flex;
  margin: 0 24rpx 20rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 8rpx;
}
.filter-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #6b7280;
  padding: 12rpx 0;
  border-radius: 10rpx;
}
.filter-active { background: #07C160; color: #ffffff; font-weight: 500; }

.prop-scroll { white-space: nowrap; margin-bottom: 20rpx; }
.prop-chip {
  display: inline-block;
  width: 300rpx;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-left: 24rpx;
  vertical-align: top;
  white-space: normal;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.prop-name { font-size: 28rpx; font-weight: 600; }
.prop-sub { font-size: 22rpx; color: #9ca3af; margin: 6rpx 0; }
.prop-stat { font-size: 22rpx; color: #07C160; }

.room-card {
  background: #ffffff;
  margin: 0 24rpx 24rpx;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.room-vacant { border-left: 8rpx solid #07C160; }
.room-rented { border-left: 8rpx solid #d1d5db; opacity: 0.85; }

.room-head { display: flex; justify-content: space-between; align-items: center; }
.room-no { font-size: 34rpx; font-weight: 700; }
.room-status { font-size: 22rpx; padding: 4rpx 16rpx; border-radius: 8rpx; }
.rs-vacant { background: #f6ffed; color: #389e0d; }
.rs-rented { background: #f5f5f5; color: #8c8c8c; }

.room-info { margin: 12rpx 0; }
.room-prop { font-size: 26rpx; color: #374151; margin-right: 16rpx; }
.room-layout { font-size: 24rpx; color: #9ca3af; }

.room-tags { display: flex; gap: 12rpx; }
.rtag {
  font-size: 20rpx;
  color: #0958d9;
  background: #e6f4ff;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
}

.room-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 18rpx;
  border-top: 1rpx solid #f3f4f6;
  padding-top: 18rpx;
}
.room-rent { font-size: 36rpx; font-weight: 700; color: #cf1322; }
.room-unit { font-size: 22rpx; color: #9ca3af; }
.room-deposit { font-size: 22rpx; color: #9ca3af; margin-left: 16rpx; }
.sign-btn {
  font-size: 26rpx;
  background: #07C160;
  color: #ffffff;
  border-radius: 28rpx;
  padding: 10rpx 36rpx;
  line-height: 1.6;
  margin: 0;
}
.sign-btn::after { border: none; }
.rented-tip { font-size: 24rpx; color: #9ca3af; }
