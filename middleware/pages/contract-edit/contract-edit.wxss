page { background: #f5f7fa; }

.h-head { display: flex; align-items: center; justify-content: space-between; }
.h-name { font-size: 32rpx; font-weight: 600; }
.tag { font-size: 22rpx; padding: 6rpx 16rpx; border-radius: 6rpx; }
.st-paid { background: #f6ffed; color: #389e0d; }
.st-info { background: #e6f4ff; color: #0958d9; }
.st-void { background: #f5f5f5; color: #8c8c8c; }

.h-sub { font-size: 24rpx; color: #9ca3af; margin-top: 6rpx; }
.h-room {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #374151;
  background: #f6ffed;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
}
.h-line { margin-top: 10rpx; font-size: 24rpx; color: #6b7280; }
.red { color: #cf1322; }

.card-title { font-size: 28rpx; font-weight: 600; margin-bottom: 12rpx; }
.fold { font-size: 22rpx; color: #9ca3af; margin-left: 12rpx; }

.f-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f3f4f6;
}
.f-row:last-child { border-bottom: none; }
.f-col { display: block; }
.f-label { font-size: 26rpx; color: #374151; }
.f-input {
  width: 280rpx;
  text-align: right;
  font-size: 26rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  padding: 10rpx 16rpx;
  box-sizing: border-box;
}
.f-value { font-size: 26rpx; color: #0958d9; }
.f-textarea {
  width: 100%;
  min-height: 140rpx;
  margin-top: 12rpx;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 26rpx;
  box-sizing: border-box;
}
.f-tip { font-size: 22rpx; color: #9ca3af; line-height: 1.6; margin-top: 16rpx; }

.full-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #374151;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
  background: #fafafa;
  border-radius: 8rpx;
  padding: 20rpx;
}

.btn-bar { padding: 0 24rpx; }
.save-btn {
  background: #07C160 !important;
  color: #ffffff !important;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.empty { text-align: center; color: #9ca3af; font-size: 26rpx; padding: 120rpx 0; }
