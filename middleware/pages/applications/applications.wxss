page { background: #f5f7fa; }

.mini-btn {
  margin-top: 24rpx;
  width: 240rpx;
  font-size: 26rpx;
}

.app-card {
  background: #ffffff;
  margin: 24rpx;
  border-radius: 16rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}
.app-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #f3f4f6;
}
.app-room { font-size: 30rpx; font-weight: 600; }
.app-row {
  display: flex;
  justify-content: space-between;
  font-size: 26rpx;
  padding: 10rpx 0;
  color: #374151;
}
.app-label { color: #6b7280; }
.app-reject {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #cf1322;
  background: #fff1f0;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
}
.app-tip {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #d48806;
  background: #fffbe6;
  border-radius: 8rpx;
  padding: 12rpx 16rpx;
}
